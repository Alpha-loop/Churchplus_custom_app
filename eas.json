{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "sim-release": {
      "extends": "production",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}